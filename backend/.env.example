# Database
DATABASE_URL=postgresql://restop:restop_password@localhost:5432/restop_db
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=restop
DB_PASSWORD=restop_password
DB_NAME=restop_db

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Environment
NODE_ENV=development
PORT=3001

# API
API_VERSION=v1
API_PREFIX=/api/v1

# Frontend
FRONTEND_URL=http://localhost:3000

# MoMo Integration (Future)
MOMO_API_KEY=
MOMO_API_SECRET=
MOMO_ENVIRONMENT=sandbox

# Platform Commission
PLATFORM_COMMISSION_PERCENT=0.03

# Logging
LOG_LEVEL=debug

# Paypack Payment Integration (Legacy)
PAYPACK_CLIENT_ID=your-client-id
PAYPACK_CLIENT_SECRET=your-client-secret
PAYPACK_API_URL=https://api.paypack.rw
PAYPACK_CALLBACK_URL=https://your-domain.com/api/webhooks/paypack
PAYPACK_WEBHOOK_SECRET=your-webhook-secret
PAYPACK_MOCK_MODE=true

# Flutterwave Payment Integration (Primary)
# Get credentials from: https://dashboard.flutterwave.com/settings/apis
FLUTTERWAVE_SECRET_KEY=your-flutterwave-secret-key
FLUTTERWAVE_SECRET_HASH=your-flutterwave-webhook-hash
FLUTTERWAVE_ENV=staging
FLUTTERWAVE_MERCHANT_NAME=Your Restaurant Name
FLUTTERWAVE_MERCHANT_EMAIL=payments@yourrestaurant.com
FLUTTERWAVE_WEBHOOK_URL=https://your-domain.com/api/v1/payments/webhooks/flutterwave
FLUTTERWAVE_MOCK_MODE=false